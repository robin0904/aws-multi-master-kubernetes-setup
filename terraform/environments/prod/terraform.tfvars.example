# =============================================================================
# terraform/environments/prod/terraform.tfvars.example
# Production environment — large instances, HA NAT, restricted CIDRs.
# IMPORTANT: Replace all placeholder CIDRs before deploying to production.
# =============================================================================

aws_region   = "us-east-1"
environment  = "prod"
cluster_name = "k8s-cluster"
project_name = "k8s-multi-master"
owner        = "platform-team"
cost_center  = "engineering"
created_date = "2024-01-01"

vpc_cidr             = "10.2.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.2.1.0/24", "10.2.2.0/24", "10.2.3.0/24"]
private_subnet_cidrs = ["10.2.10.0/24", "10.2.11.0/24", "10.2.12.0/24"]

# Production uses HA NAT to eliminate cross-AZ dependency
enable_nat_gateway_ha   = true
enable_flow_logs        = true
flow_log_retention_days = 90

# IMPORTANT: Replace with your office/VPN CIDR range
admin_cidr_block = "YOUR_OFFICE_IP/32"
api_access_cidr  = "YOUR_OFFICE_IP/32"

enable_bastion    = true
lb_type           = "haproxy"
nlb_internal      = false
enable_ecr_access = true

generate_key_pair   = false
ssh_public_key_path = "~/.ssh/k8s-prod-key.pub"
ami_id              = ""

# Production uses larger instance types
bastion_instance_type = "t3.small"
haproxy_instance_type = "t3.medium"
master_instance_type  = "m5.xlarge"
worker_instance_type  = "m5.2xlarge"

master_count = 3
worker_count = 5

master_root_volume_size = 100
worker_root_volume_size = 200

# ---- Kubernetes version pins ----
kubernetes_version  = "1.33"
containerd_version  = "1.7.23"
runc_version        = "1.2.3"
cni_plugins_version = "1.6.0"
calico_version      = "v3.29.1"
pod_cidr            = "192.168.0.0/16"
service_cidr        = "10.96.0.0/12"
