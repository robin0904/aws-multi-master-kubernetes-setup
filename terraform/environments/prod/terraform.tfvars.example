# Production Terraform variables configuration
aws_region              = "us-east-1"
environment             = "prod"
cluster_name            = "k8s-prod"
vpc_cidr                = "10.100.0.0/16"
availability_zones      = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs     = ["10.100.1.0/24", "10.100.2.0/24", "10.100.3.0/24"]
private_subnet_cidrs    = ["10.100.10.0/24", "10.100.20.0/24", "10.100.30.0/24"]
single_nat_gateway      = false # Dedicated NAT GW per AZ for HA
allowed_ssh_cidr_blocks = ["198.51.100.5/32"] # Restrict to corporate VPN / Admin IP
master_count            = 3
worker_count            = 3
bastion_instance_type  = "t3.small"
master_instance_type   = "t3.large"
worker_instance_type   = "t3.large"
k8s_version             = "v1.31"
pod_cidr                = "192.168.0.0/16"
