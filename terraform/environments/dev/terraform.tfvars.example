# =============================================================================
# terraform/environments/dev/terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored for environments with real values.
# This example file IS committed as documentation.
# =============================================================================

# ---- AWS Region ----
aws_region = "us-east-1"

# ---- Identity ----
environment  = "dev"
cluster_name = "k8s-cluster"
project_name = "k8s-multi-master"
owner        = "platform-team"
cost_center  = "engineering"
created_date = "2024-01-01"

# ---- Networking ----
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# Single NAT Gateway (false = cost-efficient for dev)
enable_nat_gateway_ha = false

# VPC Flow Logs
enable_flow_logs        = true
flow_log_retention_days = 30

# ---- Security ----
# IMPORTANT: Replace with your actual public IP address.
# Run: curl -s https://checkip.amazonaws.com
admin_cidr_block = "0.0.0.0/0"   # CHANGE THIS in real deployments
api_access_cidr  = "0.0.0.0/0"   # Restrict to your IP for prod

# ---- Feature Flags ----
enable_bastion = true

# Load balancer type: "haproxy" (default) or "nlb"
lb_type      = "haproxy"
nlb_internal = false

# Enable ECR image pulling from worker nodes
enable_ecr_access = false

# ---- SSH Key ----
# Set generate_key_pair = false and provide your own key path (recommended)
generate_key_pair   = false
ssh_public_key_path = "~/.ssh/k8s-cluster-key.pub"
# generated_key_path = "~/.ssh/k8s-cluster-generated-key.pem"  # only needed if generate_key_pair = true

# ---- AMI ----
# Leave empty to use the latest Amazon Linux 2023 in the selected region.
ami_id = ""

# ---- Instance Types ----
# Dev uses smaller types. Scale up for QA/Prod.
bastion_instance_type = "t3.micro"
haproxy_instance_type = "t3.small"
master_instance_type  = "t3.medium"
worker_instance_type  = "t3.large"

# ---- Instance Counts ----
# Must be 1, 3, or 5 for etcd quorum.
master_count = 3
worker_count = 3

# ---- Volume Sizes (GiB) ----
master_root_volume_size = 50
worker_root_volume_size = 80

# ---- Kubernetes ----
# Used by Bash installation scripts, not directly by Terraform.
kubernetes_version = "1.29"
