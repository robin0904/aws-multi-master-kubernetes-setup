# =============================================================================
# scripts/common/config.env
#
# Single source of truth for all version pins and cluster configuration.
# Sourced by EVERY script — change a value here, it propagates everywhere.
#
# Usage in scripts:
#   SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
#   source "${SCRIPT_DIR}/../common/config.env"
# =============================================================================

# ---- Kubernetes ----
# Must match kubernetes_version in terraform.tfvars
KUBERNETES_VERSION="1.33"
KUBERNETES_MINOR="1.33"

# ---- Container Runtime — containerd ----
# Check latest: https://github.com/containerd/containerd/releases
CONTAINERD_VERSION="1.7.23"
RUNC_VERSION="1.2.3"
CNI_PLUGINS_VERSION="1.6.0"

# ---- CNI Plugin ----
CNI_PLUGIN="calico"
CALICO_VERSION="v3.29.1"
CALICO_MANIFEST_URL="https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests/calico.yaml"

# ---- Pod and Service CIDRs ----
# Calico default pod CIDR — must NOT overlap with VPC CIDR (10.0.0.0/16)
POD_CIDR="192.168.0.0/16"
SERVICE_CIDR="10.96.0.0/12"
DNS_SERVICE_IP="10.96.0.10"

# ---- API Server ----
API_SERVER_PORT="6443"

# ---- AWS Region ----
AWS_REGION="ap-south-1"

# ---- Logging ----
LOG_DIR="/var/log/k8s-install"
LOG_FILE="${LOG_DIR}/install.log"

# ---- Script Behaviour ----
# Set VERBOSE=true to enable debug-level output
VERBOSE="false"
