#!/usr/bin/env bash
# ==============================================================================
# Template: user_data_master_first.sh.tftpl
# Description: User data script for provisioning the FIRST control plane node.
# ==============================================================================

set -euo pipefail

exec > >(tee /var/log/user-data-first-master.log|logger -t user-data -s 2>/dev/console) 2>&1

echo "Starting Primary Control Plane setup..."

# Embed Common Setup Script
cat << 'EOF_COMMON' > /tmp/common.sh
${common_script}
EOF_COMMON

chmod +x /tmp/common.sh
/tmp/common.sh

# Embed Install K8s Script
cat << 'EOF_K8S' > /tmp/install_k8s.sh
${install_k8s_script}
EOF_K8S

chmod +x /tmp/install_k8s.sh
/tmp/install_k8s.sh "${k8s_version}"

# Install AWS CLI v2 for Parameter Store integration
apt-get install -y unzip curl
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip awscliv2.zip && ./aws/install && rm -rf awscliv2.zip aws

# Embed Init Master Script
cat << 'EOF_INIT' > /tmp/init_first_master.sh
${init_master_script}
EOF_INIT

chmod +x /tmp/init_first_master.sh
/tmp/init_first_master.sh "${control_plane_endpoint}" "${pod_cidr}" "${k8s_version}"

echo "Primary Control Plane setup complete!"
